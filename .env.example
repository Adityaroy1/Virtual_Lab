# ─────────────────────────────────────────────────────────────
# Virtual Math Lab — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local  →  cp .env.example .env.local
# 2. Fill in values as needed
# 3. NEVER commit .env.local to version control
# ─────────────────────────────────────────────────────────────

# App metadata
VITE_APP_TITLE="MathBeta Academics — Virtual Lab"
VITE_APP_VERSION="1.0.0"

# Base URL (used for Open Graph / sharing meta tags)
# Development default: http://localhost:3000
VITE_BASE_URL=http://localhost:3000

# Analytics (optional — leave blank to disable)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature flags (true / false)
VITE_ENABLE_POSTTEST=true
VITE_ENABLE_PRETEST=true
